<Window x:Class="InspiredCodes.BarcodeScanDetector.WpfDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WPF Barcode Demo" Height="250" Width="400">
    <StackPanel Margin="20" VerticalAlignment="Center">
        <TextBlock Text="Last Scanned Barcode:" FontWeight="Bold" Margin="0,0,0,5" />
        <TextBlock x:Name="ResultTextBlock" Text="Waiting for scan..." Margin="0,0,0,20" Foreground="Blue" />
        <Button Content="Simulate Scan (UUIDv7)" Padding="10" Click="SimulateScan_Click" />
    </StackPanel>
</Window>
