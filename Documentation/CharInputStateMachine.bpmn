  <bpmn:collaboration id="Collaboration_sl8c47w">
    <bpmn:participant id="Participant_nn7p7bk" name="BarcodeScanDetector" processRef="Process_3bltn64" />
    <bpmn:textAnnotation id="TextAnnotation_cooldown_rules">
      <bpmn:text>Cooldown: 300ms enforced after successful scan or buffer overflow (caps at 4096 chars). Starts before BarcodeScanned is raised. Extends on fast inputs during cooldown. Discards inputs during cooldown. Exception: the second half of a CR+LF or LF+CR pair (the very next input after the scan's newline) is discarded without extending the cooldown. A newline with nothing buffered (e.g. right after a buffer overflow) raises no event and starts no cooldown of its own.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_s6e24gm">
      <bpmn:text>queue ignores Enter or Return</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_cooldown" sourceRef="Event_q543l80" targetRef="TextAnnotation_cooldown_rules" />
    <bpmn:association id="Association_w8gbxef" sourceRef="Activity_2p8w2uy" targetRef="TextAnnotation_s6e24gm" />
  </bpmn:collaboration>
