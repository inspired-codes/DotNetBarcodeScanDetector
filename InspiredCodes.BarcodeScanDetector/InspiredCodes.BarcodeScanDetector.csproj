<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>netstandard2.0;netstandard2.1</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>14.0</LangVersion>

        <AssemblyVersion>2.0.1.0</AssemblyVersion>
        <FileVersion>$(AssemblyVersion)</FileVersion>
        <ApplicationIcon>barcode_detector.ico</ApplicationIcon>
        
        <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
        <Version>2.0.1</Version>
        <PackageIcon>barcode_detector.png</PackageIcon>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageReleaseNotes>Core detector without UI dependencies: targets netstandard2.0 and netstandard2.1. WPF and WinForms integration is provided by separate adapter projects.</PackageReleaseNotes>
        
        <Authors>Peter Metz (pmetz@inspired.codes), Steven Lee</Authors>
        <Product>Barcode Scan Detector</Product>
        <Description>Detects very fast keyboard input sequence and fires a BarcodeScanned event</Description>
        <Copyright>Inspired Codes 2026</Copyright>
        
        <PackageLicenseExpression>MIT</PackageLicenseExpression>

        <ProduceReferenceAssembly>True</ProduceReferenceAssembly>
        <EnableNETAnalyzers>True</EnableNETAnalyzers>
        <AnalysisLevel>latest-recommended</AnalysisLevel>
        
        <!-- remove parent path from PDB symbols -->
        <AppOutputBase>$(MSBuildProjectDirectory)\</AppOutputBase>
        <PathMap>$(AppOutputBase)=InspiredCodes.BarcodeScanDetector</PathMap>
        
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\README.md">
            <Pack>True</Pack>
            <PackagePath>\</PackagePath>
        </None>
        <None Include="barcode_detector.png">
            <Pack>True</Pack>
            <PackagePath></PackagePath>
        </None>
    </ItemGroup>

</Project>
